#!/bin/sh
# Resolve our symlink with the portable, single-path form of readlink.
crew_script=$0
while [ -L "$crew_script" ]; do
  crew_dir=$(CDPATH='' cd -P "$(dirname "$crew_script")" && pwd) || exit 1
  crew_target=$(readlink "$crew_script") || exit 1
  case "$crew_target" in
    /*) crew_script=$crew_target ;;
    *) crew_script=$crew_dir/$crew_target ;;
  esac
done
crew_root=$(CDPATH='' cd -P "$(dirname "$crew_script")/.." && pwd) || exit 1
exec "$crew_root/workerbin/python3" "$crew_root/crewlib/entry.py" "$@"
