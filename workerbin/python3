#!/bin/sh
# Interpreter selection is per installation, never embedded in this repository.
if [ -n "${CREW_PYTHON:-}" ]; then
  exec "$CREW_PYTHON" "$@"
fi
crew_state=${CREW_HOME:-$HOME/.crew}
if [ -r "$crew_state/python-path" ]; then
  IFS= read -r crew_python < "$crew_state/python-path"
  if [ -x "$crew_python" ]; then exec "$crew_python" "$@"; fi
fi
crew_workerbin=$(CDPATH='' cd -P "$(dirname "$0")" && pwd) || exit 1
crew_search=$PATH
while :; do
  crew_part=${crew_search%%:*}
  crew_candidate=${crew_part:-.}/python3
  if [ -x "$crew_candidate" ]; then
    crew_parent=$(CDPATH='' cd -P "${crew_part:-.}" 2>/dev/null && pwd)
    if [ "$crew_parent" != "$crew_workerbin" ] && ! [ "$crew_candidate" -ef "$0" ]; then
      exec "$crew_candidate" "$@"
    fi
  fi
  case "$crew_search" in *:*) crew_search=${crew_search#*:} ;; *) break ;; esac
done
printf '%s\n' '找不到 Python 3.9+：请设置 CREW_PYTHON 为 Python 可执行文件路径。' >&2
exit 127
