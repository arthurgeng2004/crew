#!/bin/sh
# crew 工人用的 Python：优先 $CREW_PYTHON（比如一个装好 pandas / openpyxl / PyMuPDF 等库的 conda 环境），
# 否则用 PATH 上的 python3（跳过本目录，免得自己调自己）。
if [ -n "$CREW_PYTHON" ] && [ -x "$CREW_PYTHON" ]; then exec "$CREW_PYTHON" "$@"; fi
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
py=$(command -v python3) && exec "$py" "$@"
echo "没有可用的 python3（可设 CREW_PYTHON）" >&2; exit 127
